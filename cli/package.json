{
  "name": "@jigra/cli",
  "version": "2.4.0",
  "description": "Jigra: Cross-platform apps with JavaScript and the web",
  "homepage": "https://jigrajs.web.app",
  "author": "Family Team",
  "bin": {
    "jigra": "./bin/jigra",
    "jig": "./bin/jigra"
  },
  "engines": {
    "node": ">=8.3.0"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "npm run clean && npm run assets && tsc",
    "clean": "rimraf ./dist",
    "deploy": "np",
    "lint": "tslint --project tsconfig.json",
    "assets": "node scripts/copy-assets.js",
    "prepublishOnly": "npm run build",
    "watch": "npm run assets && tsc -w"
  },
  "files": [
    "assets/",
    "bin/",
    "dist/"
  ],
  "keywords": [
    "family",
    "family framework",
    "jigra",
    "universal app",
    "progressive web apps",
    "cross platform"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jigrajs/jigra.git"
  },
  "bugs": {
    "url": "https://github.com/jigrajs/jigra/issues"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "2.3.0",
    "commander": "4.1.1",
    "compare-versions": "3.1.0",
    "fs-extra": "4.0.3",
    "inquirer": "6.3.1",
    "open": "6.1.0",
    "ora": "1.3.0",
    "plist": "3.0.1",
    "semver": "5.4.1",
    "which": "1.3.0",
    "xml2js": "0.4.19"
  },
  "devDependencies": {
    "@types/fs-extra": "4.0.5",
    "@types/inquirer": "0.0.35",
    "@types/mock-fs": "3.6.30",
    "@types/open": "6.1.0",
    "@types/ora": "1.3.1",
    "@types/semver": "5.4.0",
    "@types/which": "1.0.28",
    "@types/xml2js": "0.4.2",
    "mock-fs": "4.4.2",
    "np": "2.18.2",
    "rimraf": "3.0.0",
    "tmp": "0.0.33",
    "tslint": "5.8.0",
    "tslint-family-rules": "0.0.21",
    "typescript": "3.7.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
